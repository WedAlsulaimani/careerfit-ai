# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key — safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role / secret key — SERVER ONLY. Used exclusively for permanent
# account deletion (auth.admin.deleteUser). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used in auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider (server only; keys are never sent to the browser) ---
# gemini (default) | anthropic
AI_PROVIDER=gemini
# Google Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional override. Defaults: gemini-2.5-flash (gemini) / claude-opus-5-5 (anthropic)
AI_MODEL=
# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Anthropic only: low | medium | high
AI_EFFORT=medium
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# Per-user daily AI call limit (enforced through the ai_usage table).
AI_DAILY_LIMIT=60
# --- PDF rendering ---
# Local development: path to an installed Chrome/Edge/Chromium. Leave empty to
# auto-detect common install locations. On Vercel, @sparticuz/chromium is used.
CHROME_EXECUTABLE_PATH=

# --- URL intake ---
URL_FETCH_TIMEOUT_MS=10000
URL_FETCH_MAX_BYTES=2000000
